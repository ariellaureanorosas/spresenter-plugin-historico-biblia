{
  "name": "com.sonext.historico-biblia",
  "version": "0.3.51",
  "private": true,
  "description": "Plugin do Spresenter que registra as referências bíblicas apresentadas ao vivo e permite reabrir uma passagem durante o culto.",
  "author": "Ariel Laureano Rosas <ariellaureanorosas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariellaureanorosas/spresenter-plugin-historico-biblia.git"
  },
  "homepage": "https://github.com/ariellaureanorosas/spresenter-plugin-historico-biblia#readme",
  "bugs": {
    "url": "https://github.com/ariellaureanorosas/spresenter-plugin-historico-biblia/issues"
  },
  "keywords": [
    "spresenter",
    "spresenter-plugin",
    "biblia",
    "historico",
    "church",
    "worship",
    "live",
    "typescript",
    "react"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "scripts": {
    "build:code": "vite build --config vite.code.config.ts",
    "build:ui": "vite build --config vite.ui.config.ts",
    "build": "npm run build:code && npm run build:ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/package.mjs",
    "dev": "concurrently -k \"npm:watch:code\" \"npm:watch:ui\"",
    "watch:code": "vite build --watch --config vite.code.config.ts",
    "watch:ui": "vite build --watch --config vite.ui.config.ts"
  },
  "dependencies": {
    "@spresenter/plugin-sdk": "file:sdk/spresenter-plugin-sdk.tgz",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "adm-zip": "^0.5.17",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "postcss": "^8.4.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
